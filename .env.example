# --- Instagram / Meta ---
IG_VERIFY_TOKEN=kendi-belirledigin-rastgele-bir-metin
IG_APP_SECRET=meta-uygulama-gizli-anahtari
IG_ACCESS_TOKEN=instagram-uzun-omurlu-erisim-tokeni
IG_ACCOUNT_ID=instagram-profesyonel-hesap-id

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5
# İsteğe bağlı: görsel eşleştirme için ayrı model (boşsa CLAUDE_MODEL kullanılır). Örn. sohbet Haiku, görsel Sonnet.
# VISION_MODEL=claude-sonnet-5-5

# İsteğe bağlı: ürün görsellerini tek seferlik tanımlayan model (varsayılan Haiku, en ucuzu yeterli)
# INDEX_MODEL=claude-haiku-4-5-20251001
# İsteğe bağlı: Instagram DM webp'i desteklemezse CONVERT_WEBP=true yapın; görseller JPEG'e çevrilip sunucunuzdan servis edilir.
# CONVERT_WEBP=true
# PUBLIC_BASE_URL=https://servis-adin.onrender.com   (Render bunu RENDER_EXTERNAL_URL olarak kendisi verir)

# --- Mağaza ---
STORE_NAME=Mağaza Adı
PRODUCT_FEED_URL=https://siteniz.com/urunler.xml
# Kampanya, kargo, ödeme, iade sayfaları (virgülle ayır)
SITE_INFO_URLS=https://siteniz.com/kampanyalar,https://siteniz.com/kargo-ve-teslimat,https://siteniz.com/odeme-secenekleri
# Ürünler ve site bilgisi kaç dakikada bir yenilensin (270 = 4,5 saat; stoklar sık değişmiyorsa yeterli)
FEED_REFRESH_MIN=270
SITE_REFRESH_MIN=270

# Ürün kaynağı: auto = önce XML, okunamazsa siteden | xml = yalnızca XML | site = yalnızca siteden
CATALOG_SOURCE=auto
# Siteden okuma (yedek) için tüm ürünlerin listelendiği kategori sayfası. Önce WooCommerce Store API denenir, kapalıysa bu sayfa taranır.
SITE_CATALOG_URL=https://siteniz.com/product-category/tum-urunler/

# WordPress'ten ürün aktarımı (Cloudflare engelliyorsa): uzun rastgele bir metin; wordpress/katalog-gonder.php'deki CB_PUSH_KEY ile aynı olmalı
# CATALOG_PUSH_KEY=uzun-rastgele-metin

# Yedek katalog dosyası: XML ve site engellenirse bot bunu okur (data/feed.xml, bkz. data/README.md)
# CATALOG_FALLBACK_FILE=data/feed.xml

# İsteğe bağlı: sabit kampanya kuralı (min adet:indirim TL). Verilirse indirimi bot değil sunucu hesaplar.
# Örnek: 2 ve üzeri alımda 300 TL, 3 ve üzeri alımda 600 TL
# CAMPAIGN_RULES=2:300,3:600

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=-1001234567890

PORT=3000
